<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);1573;1591</NoWarn>

    <IsPackable>true</IsPackable>
    <PackageId>Toxic.Aspire.NamingConventions.Azure</PackageId>
    <Version>13.0.5</Version>
    <Company>Toxic Interactive Solutions</Company>
    <PackageTags>Aspire;Azure</PackageTags>
    <Description>Contains a framework for automatically generating Aspire Azure resource names according to conventions.</Description>
    <RepositoryUrl>https://github.com/toxicinteractive/toxic-aspire-namingconventions-azure</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Security.Cryptography.Pkcs -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-r955-8q5j-3h83" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-c399-9853-6jmj" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7hqp-7c5m-4vq6" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />

    <!-- MessagePack -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.3" />
    <PackageReference Include="Aspire.Hosting.Azure.AppConfiguration" Version="13.6.3" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.3" />
    <PackageReference Include="Aspire.Hosting.Azure.AppService" Version="13.6.3" />
    <PackageReference Include="Aspire.Hosting.Azure.Sql" Version="13.6.3" />
  </ItemGroup>
</Project>
