<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- System.Security.Cryptography.Pkcs -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-r955-8q5j-3h83" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-c399-9853-6jmj" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7hqp-7c5m-4vq6" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
    <!-- MessagePack -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.Azure.AppConfiguration" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppService" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.KeyVault" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Redis" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Sql" Version="13.6.4" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>
</Project>