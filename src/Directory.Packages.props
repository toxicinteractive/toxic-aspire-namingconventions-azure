<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- System.Security.Cryptography.Pkcs -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.Azure.AppConfiguration" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppService" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.Azure.Sql" Version="13.6.2" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>
</Project>
